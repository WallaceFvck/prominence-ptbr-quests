		{
			dependencies: ["6930C77988A640AF"]
			description: [
				"  "
				"&eEstatísticas principais são aquelas que todos usam em certa medida."
				""
				"&7Seja porque você já tem uma quantidade padrão (como Vida) ou porque qualquer peça de equipamento concede a estatística (como Pressa e Armadura)  "
			]
			icon: {
				Count: 1
				id: "ftbquests:custom_icon"
