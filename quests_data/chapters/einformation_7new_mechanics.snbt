	quest_links: [ ]
	quests: [
		{
			dependencies: ["6930C77988A640AF"]
			description: [
				"  "
				"&7As mecânicas de combate foram alteradas pelo mod &eBetter Combat&7."
				""
				"- &6&lArmas &r&7Cada arma tem sua própria animação e tempo de ataque."
				""
				"- &6&lCombos &r&7Ataques consecutivos realizarão combos."
				""
				"- &6&lSegurar para atacar &r&7Você pode segurar o botão de ataque para continuar atacando continuamente.  "
			]
			icon: {
				Count: 1
				id: "minecraft:shield"
				tag: {
					Damage: 0
				}
			}
			id: "51595E88AF1F475E"
			rewards: [{
				id: "73FEF9863E4C5F38"
				type: "xp"
				xp: 100
			}]
			shape: "hexagon"
			subtitle: "Continuar"
			tasks: [{
				id: "7AAEF7553C3616AE"
				title: "&eNovas Mecânicas Defensivas"
				type: "checkmark"
			}]
			title: "&8[Clique para ler mais]"
			x: 1.5d
			y: -2.5d
		}
		{
			dependencies: ["6930C77988A640AF"]
			description: [
				"  "
				"&7Esta linha de missões de tutorial explica como o combate funciona, desde mecânicas alteradas até como se construir."
				""
				"&eEmbora este seja um tutorial inicial, ele se estende até builds de fim de jogo. Mais missões aparecerão conforme você progride."
				""
				"&7A maior parte desta linha de missões é apenas leitura, &cpor favor, certifique-se de ler&7 se quiser realmente entender as coisas, pois são informações importantes.  "
			]
			icon: {
				Count: 1
				id: "minecraft:netherite_sword"
				tag: {
					Damage: 0
				}
			}
			id: "6B8B4323E13AB3E9"
			rewards: [{
				id: "475CDA6694C41230"
				type: "xp"
				xp: 100
			}]
			shape: "hexagon"
			subtitle: "Continuar"
			tasks: [{
				id: "3589A9BB969BA94E"
				title: "&eNovas Mecânicas de Combate"
				type: "checkmark"
			}]
			title: "&8[Clique para ler mais]"
			x: -1.5d
			y: -2.5d
		}
		{
			description: [
				"  "
				"&7Os seguintes guias irão direcionar você sobre o que procurar dependendo de tipos específicos de build. Estas não são builds totalmente desenvolvidas, são apenas guias para você seguir sobre quais equipamentos escolher dependendo do seu estilo de jogo."
				""
				"&eA dificuldade mostrada se aplica tanto à dificuldade de jogar quanto à dificuldade de fazer a build &7(Embora a dificuldade de gameplay tenha mais prioridade)&7."
				""
				"&6Como os tiers funcionam?"
				""
				"&7Tier I: &eEquipamento Inicial &8(Mundo superior)  "
				"&eTier II: &eInício de jogo &8(Pós Nether)  "
				"&6Tier III: &eMeio de jogo &8(Pós End)  "
				"&cTier IV: &eFim de jogo / Endgame &8(Pós Artefatos)  "
				"&dTier V: &e&kPrimordial&r &8(Desconhecido)"
				""
				"&eEsta parte da linha de missões pode ficar complexa! Para aprender mais sobre como obter Livros de Habilidade, leia a linha de missões de Conjuração."
				""
				"&6Para guias completos sobre builds específicas, consulte o wiki oficial!  "
			]
			icon: {
				Count: 1
				id: "ftbquests:custom_icon"
				tag: {
					Icon: "ftblibrary:icons/info_gray"
				}
			}
			id: "6930C77988A640AF"
			shape: "hexagon"
			subtitle: "Continuar"
			tasks: [{
				id: "4B87D5A81113B3B8"
				title: "&eComo funciona o Combate \\& Equipamentos?"
				type: "checkmark"
			}]
			title: "&8[Clique para ler mais]"
			x: 0.0d
			y: -3.0d
		}
		{
			dependencies: [
				"51595E88AF1F475E"
				"6B8B4323E13AB3E9"
			]
			description: [
				"  "
				"&7Estatísticas, também conhecidas como atributos, são uma série de números associados ao seu personagem que permitem que outras coisas escalem a partir deles."
				""
				"&7Por exemplo, Pressa define a velocidade de ataque, enquanto vida define quanta vida você tem, etc."
				""
				"&7As próximas missões irão explicar as principais estatísticas e por que cada uma é importante para usos específicos."
				""
				"&eAs estatísticas são uma parte central do seu equipamento, é importante entender quais estatísticas você precisa e quais não precisa dependendo de como você quer montar sua build.  "
			]
			hide_until_deps_visible: true
			icon: {
				Count: 1
				id: "ftbquests:custom_icon"
				tag: {
					Icon: "tiered:textures/gui/anvil_tab_icon.png"
