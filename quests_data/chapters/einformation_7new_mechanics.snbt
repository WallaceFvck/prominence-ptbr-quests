				type: "checkmark"
			}]
			title: "&eStats Principais"
			x: -1.5d
			y: -5.5d
		}
		{
			dependencies: ["44D9519561FE2D1B"]
			description: [
				"&eVárias estatísticas projetadas para opções de combate à distância."
				""
				"&7Enquanto Dano Físico é usado por todos, builds à distância vão preferir outras estatísticas dependendo do caminho escolhido; &eArquearia&7 (Físico à Distância) ou &eConjuração &7(Magia à Distância)"
				""
				"&7Magia também pode ser usada no corpo a corpo, com builds de Espada Mágica."
			]
			hide_until_deps_visible: true
			icon: {
				Count: 1
				id: "ftbquests:custom_icon"
