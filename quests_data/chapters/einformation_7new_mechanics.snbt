			tasks: [{
				id: "30BD1DF965773137"
				title: "&eComo os atributos funcionam?"
				type: "checkmark"
			}]
			title: "&8[Clique para ler mais]"
			x: 0.0d
			y: -4.5d
		}
		{
			dependencies: ["44D9519561FE2D1B"]
			description: [
				"  "
				"&eVárias estatísticas são projetadas para opções à distância."
				""
				"&7Enquanto Dano Físico é usado por todos, builds à distância preferirão outras estatísticas dependendo do caminho que seguirem; &eArquearia&7 (Físico à distância) ou &eConjuração &7(Mágico à distância)"
				""
				"&7Magia também pode ser usada corpo a corpo, com builds de Lâmina Mágica.  "
			]
			hide_until_deps_visible: true
			icon: {
				Count: 1
				id: "ftbquests:custom_icon"
