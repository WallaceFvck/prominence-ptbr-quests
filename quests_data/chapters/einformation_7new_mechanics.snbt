	quests: [
		{
			dependencies: ["6930C77988A640AF"]
			description: [
				"&7Todos os escudos têm novas mecânicas do mod &eShield Overhaul&7."
				""
				"- &e&lGolpe com escudo &r&7Ataque enquanto estiver bloqueando para realizar um golpe de escudo. &7Isso irá atordoar o alvo por 1 segundo, a menos que seja um chefe."
			]
			icon: {
				Count: 1
				id: "minecraft:shield"
				tag: {
					Damage: 0
				}
			}
			id: "51595E88AF1F475E"
			rewards: [{
				id: "73FEF9863E4C5F38"
				type: "xp"
				xp: 100
			}]
			shape: "hexagon"
			subtitle: "&8[Clique para ler mais]"
			tasks: [{
				id: "7AAEF7553C3616AE"
				title: "Continuar"
				type: "checkmark"
			}]
			title: "&eNovas Mecânicas Defensivas"
			x: 1.5d
			y: -2.5d
		}
		{
			dependencies: ["6930C77988A640AF"]
			description: [
				"&7As mecânicas de combate foram alteradas pelo mod &eBetter Combat&7."
				""
				"- &6&lArmas &r&7Cada arma possui sua própria animação e tempo de ataque."
				""
				"- &6&lCombos &r&7Ataques consecutivos irão realizar combos."
				""
				"- &6&lSegure para atacar &r&7Você pode segurar o botão de ataque para continuar atacando continuamente."
			]
			icon: {
				Count: 1
				id: "minecraft:netherite_sword"
				tag: {
					Damage: 0
				}
			}
			id: "6B8B4323E13AB3E9"
			rewards: [{
				id: "475CDA6694C41230"
				type: "xp"
				xp: 100
			}]
			shape: "hexagon"
			subtitle: "&8[Clique para ler mais]"
			tasks: [{
				id: "3589A9BB969BA94E"
				title: "Continuar"
				type: "checkmark"
			}]
			title: "&eNovas Mecânicas de Combate"
			x: -1.5d
			y: -2.5d
		}
		{
			description: [
				"&7Esta linha de missões tutorial explica como o combate funciona, desde mecânicas alteradas até como montar sua build."
				""
				"&eEmbora este seja um tutorial de início de jogo, ele se estende até builds de fim de jogo. Mais missões aparecerão conforme você progride."
				""
				"&7A maior parte desta linha de missões é só leitura, &cpor favor leia&7 se quiser realmente entender as coisas, pois são informações importantes."
			]
			icon: {
				Count: 1
				id: "ftbquests:custom_icon"
				tag: {
					Icon: "ftblibrary:icons/info_gray"
				}
			}
			id: "6930C77988A640AF"
			shape: "hexagon"
			subtitle: "&8[Clique para ler mais]"
			tasks: [{
				id: "4B87D5A81113B3B8"
				title: "Continuar"
				type: "checkmark"
			}]
			title: "&eComo funcionam o Combate \\& Equipamentos?"
			x: 0.0d
			y: -3.0d
		}
		{
			dependencies: [
				"51595E88AF1F475E"
				"6B8B4323E13AB3E9"
			]
			description: [
				"&7Os guias a seguir vão direcionar você sobre o que procurar dependendo de tipos específicos de build. Essas não são builds totalmente completas, são apenas guias para você seguir sobre quais equipamentos escolher dependendo do seu estilo de jogo."
				""
				"&eA dificuldade mostrada se aplica tanto à dificuldade de jogar quanto à dificuldade de montar a build &7(Embora a dificuldade de gameplay tenha mais prioridade)&7."
				""
				"&6Como os tiers funcionam?"
				""
				"&7Tier I: &eEquipamento Inicial &8(Mundo Superior)"
				"&eTier II: &eInício de Jogo &8(Pós-Nether)"
				"&6Tier III: &eMeio de Jogo &8(Pós-End)"
				"&cTier IV: &eFim/Fim de Jogo &8(Pós-Artefatos)"
				"&dTier V: &e&kPrimordial&r &8(Desconhecido)"
				""
				"&eEsta parte da linha de missões pode ficar complexa! Para aprender mais sobre como conseguir Skill Books, leia a linha de missões de Spellcasting."
				""
				"&6Para guias completos de builds específicas, confira a wiki oficial!"
			]
			hide_until_deps_visible: true
			icon: {
				Count: 1
				id: "ftbquests:custom_icon"
				tag: {
					Icon: "tiered:textures/gui/anvil_tab_icon.png"
				}
			}
			id: "61C05AE305488DF5"
			rewards: [
				{
					exclude_from_claim_all: true
					id: "317E2316EEFC9AAE"
					table_id: 3737891217858354553L
					type: "choice"
				}
				{
					exclude_from_claim_all: true
					id: "44F8556F47340107"
					table_id: 5228678659320885423L
					type: "choice"
				}
			]
			shape: "none"
			subtitle: "&8[Clique para ler mais]"
			tasks: [{
				id: "22AD24EC0678727A"
				title: "Continuar"
				type: "checkmark"
			}]
			title: "&eComo eu sei quais equipamentos pegar?"
			x: 0.0d
			y: 0.5d
		}
		{
			dependencies: ["6930C77988A640AF"]
			description: [
				"&7Stats, também conhecidas como atributos, são uma série de números associados ao seu personagem que permitem que outras coisas escalem a partir delas."
				""
				"&7Por exemplo, Agilidade define quão rápido você ataca, enquanto vida define quanta vida você tem, etc."
				""
				"&7As próximas missões explicarão os principais stats e como cada um é importante para usos específicos."
				""
				"&eOs stats são uma parte central do seu equipamento, é importante que você entenda quais stats você precisa e quais não precisa dependendo de como quer montar sua build."
			]
			icon: {
				Count: 1
				id: "ftbquests:custom_icon"
				tag: {
					Icon: "fwaystones:item/empty_waystone_scroll"
				}
			}
			id: "44D9519561FE2D1B"
			shape: "hexagon"
			size: 1.0d
			subtitle: "&8[Clique para ler mais]"
			tasks: [{
				id: "30BD1DF965773137"
				title: "Continuar"
				type: "checkmark"
			}]
			title: "&eComo os stats funcionam?"
			x: 0.0d
			y: -4.5d
		}
		{
			dependencies: ["44D9519561FE2D1B"]
			description: [
				"&eStats Principais são os stats que todos usam em certa medida."
				""
				"&7Seja porque você já possui uma quantidade padrão (como Vida) ou porque qualquer peça de equipamento concede o stat (como Agilidade e Armadura)"
			]
			hide_until_deps_visible: true
			icon: {
				Count: 1
				id: "ftbquests:custom_icon"
				tag: {
					Icon: "minecraft:textures/gui/sprites/hud/heart/frozen_hardcore_full.png"
				}
			}
			id: "3F794C7D175F14C0"
			shape: "hexagon"
			size: 1.1d
			subtitle: "&8[Clique para ler mais]"
			tasks: [{
				id: "6F23FA02C5CA4AD2"
