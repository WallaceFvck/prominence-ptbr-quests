	order_index: 1
	quest_links: [ ]
	quests: [
		{
			description: [
				"&7Ao criar ou obter ferramentas, armaduras ou armas, você notará que elas têm uma qualidade."
				""
				"&7As qualidades variam de:"
				"&8- &fComum"
				"&8- &2Incomum"
				"&8- &3Raro"
				"&8- &dÉpico"
				"&8- &6Lendário"
				"&8- &cMítico"
				""
				"{@pagebreak}"
				""
				"&6Reforjamento&7 é uma parte essencial do seu progresso, pois permite mudar a raridade que seu item possui."
				""
				"&7Para isso, você pode encontrar a aba &eReforjamento&7 em uma &eBigorna&7. Você precisará de:"
				""
				"&8- &eMaterial Base &8(Slot Esquerdo)"
				"&8- &eO Item a Reforjar &8(Slot do Meio)"
				"&8- &eMaterial de Reforjamento &8(Slot Direito)"
				""
				""
				"{@pagebreak}"
				""
				"&e&lMaterial Base &r&8(Slot Esquerdo)"
				""
				"&7O material base está diretamente relacionado ao item que você deseja reforjar. Por exemplo, uma &eVarinha Sagrada&7 exigiria um &eLingote de Ouro&7 como material base. Você pode ver os materiais necessários ao passar o mouse sobre o botão de reforjar depois de colocar seu item no slot do meio."
				""
				""
				"{@pagebreak}"
				""
				"&e&lItem Base &r&8(Slot do Meio)"
				""
				"&7O Item Base é o item que você deseja mudar a raridade. Nem todos os itens podem ser reforjados, apenas ferramentas, armas e armaduras."
				""
				""
				"{@pagebreak}"
				""
				"&e&lMaterial de Reforjamento"
				""
				"&7Este material decidirá para qual qualidade seu item será reforjado; existem 3 níveis de materiais que você pode ver nas próximas missões desta linha de missões."
				""
				""
				"{@pagebreak}"
				""
				"&a&lAumentando Suas Chances"
				""
				"&7Não é só sobre grindar! Você pode &eaumentar as chances de obter qualidades superiores&7 com sua &aSorte&7! Itens que dão sorte passivamente, poções de sorte, trinkets, vinho — pegue todos eles!"
			]
			id: "3C95FD1F14D109CF"
			shape: "hexagon"
			subtitle: "&8[Clique para ler instruções]"
			tasks: [{
				id: "71FAC91280FBBF9C"
				item: "minecraft:anvil"
				title: "Crie uma Bigorna"
				type: "item"
			}]
			title: "&eO que é Reforjamento?"
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["3C95FD1F14D109CF"]
			description: [
				"&7O &nFragmento de Calcário&r&7 é o material de reforjamento de primeiro nível."
				""
				"&7Ele é encontrado no &aMundo Superior&7, obtido ao &ecraftar&7 4x &fBlocos de Calcário&r&8 (para 4 peças)&7, ou 4x &fBloco de Diorito&r &8(para 4 peças)"
				""
				"&7Ele pode reforjar para as seguintes qualidades:"
				"&8- &fComum"
				"&8- &2Incomum"
				"&8- &3Raro"
				"&8- &dÉpico"
			]
			id: "4D3F0D8217067D24"
			shape: "diamond"
			subtitle: "&8[Clique para ler instruções]"
			tasks: [{
				id: "4593A7256861742B"
				item: "tiered:limestone_chunk"
				type: "item"
			}]
			title: "&6&lNível I: &fCalcário"
			x: 0.0d
			y: 2.5d
		}
		{
			dependencies: ["4D3F0D8217067D24"]
			description: [
				"&7O &nFragmento de Pirita&r&7 é o material de reforjamento de segundo nível."
				""
				"&7Ele é encontrado no &cNether&7, obtido ao &eCraftar&7 usando 4 &6Pó de Pirita&r&8 (para 1 peça)&7, ou ao &eFundir&7 um bloco de &6Detritos Ancestrais&r&7 &8(para 4 peças)"
				""
				"&8* O Pó de Pirita pode ser obtido minerando Minério de Pirita no Nether"
				""
				"&7Ele pode reforjar para as seguintes qualidades:"
				"&8- &2Incomum"
				"&8- &3Raro"
				"&8- &dÉpico"
				"&8- &6Lendário"
			]
			id: "31388834855FB88E"
