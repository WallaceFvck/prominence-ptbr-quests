	quests: [
		{
			dependencies: [
				"49C9DC2F3D131A14"
				"5B31D4D4029F1891"
			]
			dependency_requirement: "one_completed"
			description: [
				"&eNível Recomendado: 10"
				"&cMais adequado para à distância"
				""
				"&7&oAs almas dos reis há muito mortos do Reino de Ly'rell foram ressuscitadas e corrompidas pelo Vazio, agora conhecidas como um único monstro chamado Lich Noturno."
				""
				"&7&oO Lich Noturno habita na superfície do Mundo Superior. Procure-o nos biomas frios, dentro dos restos de uma torre destruída."
				""
				"&7&oPara encontrar essa estrutura, use Estrelas da Alma, obtidas de criaturas mortas-vivas, que o guiarão até a torre."
				""
				"&eDica: &7Este é um chefe de longo alcance, use uma montaria voadora se for corpo a corpo, ou um arco como arma secundária!"
				""
				"&8Inglês"
				"{@pagebreak}"
				"&eNível Recomendado: 10"
				"&cRecomendado para Arqueiros e Magos."
				""
				"&7&oAs almas dos antigos reis do Reino de Ly'rell, que morreram há muito tempo, foram ressuscitadas e corrompidas pelo Vazio, formando um grande monstro agora conhecido como Lich Noturno."
				""
				"&7&oNos biomas mais frios, no topo dos restos de uma grande torre destruída, eles permanecem aprisionados."
				""
				"&7&oPara encontrar essa estrutura, use as Estrelas da Alma, obtidas de criaturas mortas-vivas, que o guiarão até a torre."
				""
				"&eDica: &7Este chefe é de longo alcance, use uma montaria voadora se for corpo a corpo, ou um arco como arma secundária!"
				""
				"&8Espanhol"
			]
